# Copy to .env (never commit .env). Process environment variables take precedence over this file.
# --- engine
# ERASURE_DATASET_DIR=dataset
# ERASURE_CACHE_DIR=.cache
# ERASURE_CLASSIFIER=rules        # rules | llm
# --- model (only used with ERASURE_CLASSIFIER=llm or screenshot extraction)
LLM_PROVIDER=gemini               # gemini | anthropic | none
GEMINI_API_KEY=                   # alias: GOOGLE_GENERATIVE_AI_API_KEY
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# --- service
# ERASURE_EXECUTION_MODE=sync     # sync | temporal
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_TASK_QUEUE=erasure-audit
# ERASURE_APPROVAL_TIMEOUT_S=604800
# ERASURE_OUTBOX_PATH=.cache/remediation_outbox.jsonl
